{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haohongfei2001-png/local-aem-manager/schemas/project-state.schema.json",
  "title": "ProjectState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "repo",
    "default_branch",
    "portfolio_state",
    "observed_at",
    "writer_lease",
    "checks",
    "blocker"
  ],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "default_branch": {"type": "string", "minLength": 1},
    "current_scope": {"type": ["string", "null"]},
    "canonical_status": {"type": ["string", "null"]},
    "remote_head": {"type": ["string", "null"]},
    "portfolio_state": {
      "type": "string",
      "enum": ["UNKNOWN", "IDLE", "ACTIVE", "WAITING_EXTERNAL", "BLOCKED", "NEEDS_OWNER", "COMPLETE"]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "last_verified_progress_at": {"type": ["string", "null"], "format": "date-time"},
    "writer_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "enum": ["ACTIVE", "SUSPECT", "STALE", "RELEASED", "BLOCKED"]},
        "holder": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]},
        "last_verified_activity_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": true
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "owner_required"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["NONE", "TECHNICAL", "ENVIRONMENT", "AUTHORITY", "PRODUCT", "EXTERNAL"]
        },
        "description": {"type": ["string", "null"]},
        "owner_required": {"type": "boolean"}
      }
    },
    "next_action_summary": {"type": ["string", "null"]}
  }
}
