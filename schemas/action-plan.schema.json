{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haohongfei2001-png/local-aem-manager/schemas/action-plan.schema.json",
  "title": "ActionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "decision_id",
    "project_id",
    "executor",
    "operation",
    "target",
    "params",
    "verification",
    "idempotency_key",
    "dry_run"
  ],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "executor": {
      "type": "string",
      "enum": ["SHELL", "GITHUB", "CODEX"]
    },
    "operation": {
      "type": "string",
      "enum": ["RUN_SHELL", "GITHUB_MUTATION", "CODEX_TASK"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "properties": {
        "repo": {"type": "string"},
        "branch": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]}
      }
    },
    "params": {"type": "object"},
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["JOB_SUCCEEDED", "FILE_EXISTS", "FILE_TEXT_EQUALS"]
          },
          "path": {"type": ["string", "null"]},
          "expected": {"type": ["string", "null"]}
        }
      }
    },
    "idempotency_key": {"type": "string", "minLength": 1},
    "dry_run": {"type": "boolean"}
  }
}
